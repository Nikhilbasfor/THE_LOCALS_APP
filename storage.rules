rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Guide profile & Aadhaar verification uploads
    match /guides/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Itinerary gallery photos uploaded by guides
    match /itineraries/gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // General user uploads
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
