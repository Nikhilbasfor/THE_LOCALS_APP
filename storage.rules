rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Guide profile & Aadhaar verification uploads
    match /guides/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Itinerary photos & PDFs (mobile & web)
    match /itineraries/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /experiences/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // General user & profile uploads
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Fallback general uploads
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
